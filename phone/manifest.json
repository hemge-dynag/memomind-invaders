{
  "id": "com.dynag.invaders.phone",
  "name": "Space Invader",
  "version": "1.0.0",
  "entry": "index.html",
  "bridgeVersion": "2.0",
  "permissions": [
    {
      "name": "storage",
      "required": true
    },
    {
      "name": "device.info",
      "required": true
    },
    {
      "name": "device.messaging",
      "required": true,
      "scope": {
        "channels": [
          18755,
          18757
        ]
      }
    },
    {
      "name": "device.events",
      "required": false,
      "scope": {
        "types": [
          "connection"
        ]
      }
    }
  ],
  "deviceRequirements": {
    "preferredPluginId": "com.dynag.invaders.glass",
    "requiredPluginId": "com.dynag.invaders.glass",
    "minPluginVersion": "1",
    "protocols": [
      {
        "id": "gm.invaders",
        "minVersion": "1.0"
      }
    ]
  },
  "schemaVersion": 2,
  "permissionPolicyVersion": 1
}
